DB_USERNAME=
DB_PASSWORD=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

FLOWFORGE_RECOVERY_ENABLED=true
FLOWFORGE_RECOVERY_TOKEN=replace-with-a-long-random-secret

# OIDC issuer and API audience. No real client secret belongs here.
# Local Keycloak: http://localhost:8180/realms/flowforge
FLOWFORGE_OIDC_ISSUER_URI=http://localhost:8180/realms/flowforge
FLOWFORGE_OIDC_AUDIENCE=flowforge-api

# Local Keycloak bootstrap admin. Set these in .env, which is not committed.
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=