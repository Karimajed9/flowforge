# Optional origin for API requests, with no path and no trailing slash.
# Leave this unset so the app calls /api on the same origin.
# The Vite dev server proxies /api to http://localhost:8080.
# VITE_API_BASE_URL=

# Authorization code + PKCE. Defaults match the local Keycloak realm.
# VITE_OIDC_ISSUER_URI=http://localhost:8180/realms/flowforge
# VITE_OIDC_CLIENT_ID=flowforge-api
